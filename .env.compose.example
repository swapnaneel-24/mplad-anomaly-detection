# ---------------------------------------------------------------------------
# PEIARS local Docker Compose environment — TEMPLATE ONLY.
#
# Copy to `.env.compose` at the repository root and fill in real values:
#   cp .env.compose.example .env.compose
#
# This file is distinct from the application's repo-root `.env` (used for
# host-level `python scripts/serve.py` development). The Compose stack reads
# `.env.compose` only when passed explicitly:
#   docker compose --env-file .env.compose <command>
#
# NEVER commit `.env.compose`. It is gitignored. No real credentials belong
# in this template — only safe defaults and clearly-marked placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL (dedicated db service) --------------------------------------
# The Compose `db` service (postgres:16-alpine) reads these. The backend and
# migrate services construct PEIARS_DATABASE_URL from them, so they live in
# one place. Use a local-only password; do not reuse a production credential.
POSTGRES_USER=peiars_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD
POSTGRES_DB=peiars_review

# --- Application environment -------------------------------------------------
# Local-development stack: HTTP loopback, so cookies must not require HTTPS.
# PEIARS_ENVIRONMENT=production with SESSION_COOKIE_SECURE=false is REJECTED
# by the Settings model validator (fail-closed production cookie policy).
PEIARS_ENVIRONMENT=development
PEIARS_SESSION_COOKIE_SECURE=false

# --- Synthetic demonstration records ----------------------------------------
# true for local investigation-workflow testing (synthetic, clearly-fictional
# records). MUST be false in production. Disable to verify CONT-13.
PEIARS_DEMONSTRATION_SOURCES=true

# --- CSRF signing secret (REQUIRED) -----------------------------------------
# Signs CSRF tokens (HMAC-SHA256). Generate a unique 64-char hex string from
# 32 cryptographically random bytes. NEVER keep the placeholder below — the
# Settings validator rejects placeholder markers at startup even when they
# are long enough (CONT-02/CONT-03 fail-closed).
#
# POSIX:      openssl rand -hex 32
# PowerShell (instance-based, PS 5.1+ and 7+):
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 32
#   $rng.GetBytes($bytes)
#   -join ($bytes | ForEach-Object { $_.ToString('x2') })
#
# Documented check (the value must be 64 hex chars from 32 random bytes):
#   $s = '<your generated value>'
#   if ($s -match '^[0-9a-f]{64}$') { 'OK: 64 hex chars' } else { 'INVALID' }
PEIARS_SESSION_SECRET=CHANGE_ME_GENERATE_A_64_CHAR_HEX_SECRET

# --- Browser-visible origin --------------------------------------------------
# Must match the host port published by the frontend service and the host
# you navigate to. The nginx proxy makes /api same-origin, so CORS is only
# consulted for direct/debug access. Change if you override PEIARS_FRONTEND_PORT.
PEIARS_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Host port mapping (frontend) -------------------------------------------
# The single browser-visible port. Change if 8080 is in use on your host.
PEIARS_FRONTEND_PORT=8080

# --- Optional debug overrides (commented out by default) --------------------
# Expose PostgreSQL to the host for debugging ONLY (do not enable in shared
# environments). The db service reads these only if its `ports:` block is
# uncommented in compose.yaml.
# PEIARS_DB_DEBUG_PORT=5433
# Expose the backend directly to the host for debugging ONLY. The browser
# must still use the frontend origin (http://localhost:8080) so cookies and
# CSRF work; a direct backend hit is for curl-level diagnostics.
# PEIARS_BACKEND_DEBUG_PORT=8000
