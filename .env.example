# ---------------------------------------------------------------------------
# PEIARS environment configuration — TEMPLATE ONLY.
#
# Copy to `.env` for local development and fill in real values there.
# NEVER commit `.env` or any file containing real credentials.
# This template contains placeholders and empty values only: no real
# credentials, personal paths or production endpoints.
#
# PR-01 status: no service consumes these variables yet. Later PRs
# (FastAPI app, PostgreSQL, authentication, deployment) will document the
# exact variables they read; categories below anticipate that configuration.
# ---------------------------------------------------------------------------

# --- Application environment ------------------------------------------------
# development | test | production
PEIARS_ENV=development

# --- API configuration -------------------------------------------------------
PEIARS_API_HOST=127.0.0.1
PEIARS_API_PORT=8000
PEIARS_API_ROOT_PATH=/api/v1
# Comma-separated list of allowed browser origins (CORS).
PEIARS_API_CORS_ORIGINS=http://localhost:5173

# --- Database connection (review-case store; introduced in PR-03) ------------
# The application reads PEIARS_DATABASE_URL as the full SQLAlchemy URL.
# When PEIARS_DATABASE_REQUIRED is true, readiness probes actual connectivity.
# Leave URL empty/unset when the database is not configured (readiness then
# behaves as in PR-02: no required dependencies).
PEIARS_DATABASE_URL=
PEIARS_DATABASE_REQUIRED=false
# Connection-pool lifecycle (optional; defaults shown).
PEIARS_DB_POOL_SIZE=5
PEIARS_DB_MAX_OVERFLOW=10
PEIARS_DB_POOL_PRE_PING=true
PEIARS_DB_POOL_RECYCLE_SECONDS=1800

# Legacy individual DB fields (PR-01 template; not read by the PR-03 app
# directly — assemble them into PEIARS_DATABASE_URL for local development):
#   postgresql+psycopg://peiars_app:CHANGE_ME_LOCAL_DB_PASSWORD@localhost:5432/peiars_review
PEIARS_DB_HOST=localhost
PEIARS_DB_PORT=5432
PEIARS_DB_NAME=peiars_review
PEIARS_DB_USER=peiars_app
PEIARS_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# --- Authentication / session (introduced in PR-04) --------------------------
# PR-04 implements local PostgreSQL-backed accounts (no external identity
# provider). The session secret signs CSRF tokens (HMAC-SHA256); generate a
# unique random value for each environment (>= 32 chars, e.g.
# `openssl rand -hex 32`); never reuse or commit it. When unset, the auth
# endpoints fail closed with a sanitized 503.
PEIARS_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
# Absolute session lifetime (minutes), enforced server-side.
PEIARS_SESSION_TTL_MINUTES=480
# Idle-timeout window (minutes) enforced from last_seen_at, server-side.
PEIARS_SESSION_IDLE_TIMEOUT_MINUTES=240
# Session cookie Secure flag. Production default (true) sends cookies only
# over HTTPS; local HTTP development may explicitly set false.
PEIARS_SESSION_COOKIE_SECURE=true
# Cookie names (optional). A single-host HTTPS deployment may use the
# __Host- prefix for extra browser guarantees, e.g. __Host-peiars_session.
PEIARS_SESSION_COOKIE_NAME=peiars_session
PEIARS_CSRF_COOKIE_NAME=peiars_csrf
# Database-backed failed-login lockout policy (shared across workers).
PEIARS_AUTH_LOCKOUT_THRESHOLD=5
PEIARS_AUTH_LOCKOUT_MINUTES=15

# --- Approved artifact locations ---------------------------------------------
# Server-side approved roots for research artifacts and admitted source
# snapshots, relative to the repository root. Resolved only through the
# server-side source registry (never from client-supplied paths).
PEIARS_RESEARCH_ARTIFACTS_ROOT=./results
PEIARS_SOURCE_SNAPSHOT_ROOT=./data

# --- Optional object storage (NOT required for PR-01) ------------------------
# Leave empty unless a trusted offline provisioning workflow supplies them.
# Never place these values in prompts, logs or the browser. No DVC remote
# access is performed by the application; DVC credentials are not stored here.
PEIARS_OBJECT_STORE_ENDPOINT=
PEIARS_OBJECT_STORE_BUCKET=
PEIARS_OBJECT_STORE_KEY_ID=
PEIARS_OBJECT_STORE_SECRET=
