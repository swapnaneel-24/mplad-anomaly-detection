# ---------------------------------------------------------------------------
# PEIARS environment configuration — TEMPLATE ONLY.
#
# Copy to `.env` for local development and fill in real values there.
# NEVER commit `.env` or any file containing real credentials.
# This template contains placeholders and empty values only: no real
# credentials, personal paths or production endpoints.
#
# PR-01 status: no service consumes these variables yet. Later PRs
# (FastAPI app, PostgreSQL, authentication, deployment) will document the
# exact variables they read; categories below anticipate that configuration.
# ---------------------------------------------------------------------------

# --- Application environment ------------------------------------------------
# development | test | production
PEIARS_ENV=development

# --- API configuration -------------------------------------------------------
PEIARS_API_HOST=127.0.0.1
PEIARS_API_PORT=8000
PEIARS_API_ROOT_PATH=/api/v1
# Comma-separated list of allowed browser origins (CORS).
PEIARS_API_CORS_ORIGINS=http://localhost:5173

# --- Database connection (review-case store; introduced in PR-03) ------------
PEIARS_DB_HOST=localhost
PEIARS_DB_PORT=5432
PEIARS_DB_NAME=peiars_review
PEIARS_DB_USER=peiars_app
PEIARS_DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# --- Authentication / session (introduced in PR-04) --------------------------
# Generate a unique random value for each environment; never reuse or commit.
PEIARS_SESSION_SECRET=CHANGE_ME_RANDOM_SESSION_SECRET
PEIARS_SESSION_TTL_MINUTES=480
# Identity-provider selection is an unresolved ADR item; placeholder only.
PEIARS_AUTH_PROVIDER=CHANGE_ME_AUTH_PROVIDER

# --- Approved artifact locations ---------------------------------------------
# Server-side approved roots for research artifacts and admitted source
# snapshots, relative to the repository root. Resolved only through the
# server-side source registry (never from client-supplied paths).
PEIARS_RESEARCH_ARTIFACTS_ROOT=./results
PEIARS_SOURCE_SNAPSHOT_ROOT=./data

# --- Optional object storage (NOT required for PR-01) ------------------------
# Leave empty unless a trusted offline provisioning workflow supplies them.
# Never place these values in prompts, logs or the browser. No DVC remote
# access is performed by the application; DVC credentials are not stored here.
PEIARS_OBJECT_STORE_ENDPOINT=
PEIARS_OBJECT_STORE_BUCKET=
PEIARS_OBJECT_STORE_KEY_ID=
PEIARS_OBJECT_STORE_SECRET=
