# ---------------------------------------------------------------------------
# PEIARS backend local-environment template (PR-06A).
#
# Copy this file to the REPOSITORY ROOT as `.env` and fill in real values:
#
#   Windows (PowerShell):   Copy-Item backend\.env.example .env
#   POSIX (bash/zsh):      cp backend/.env.example .env
#
# NEVER commit `.env` or any file containing real credentials.
# This template contains safe defaults and placeholders only.
#
# Loading: `backend/scripts/serve.py` loads the repository-root `.env`
# via python-dotenv BEFORE Settings() is constructed. Explicit environment
# variables always take precedence over .env values.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
# development | test | production
# NOTE: the field name is `environment`, so the variable is
# PEIARS_ENVIRONMENT (env_prefix "PEIARS_" + field name). A variable named
# PEIARS_ENV is NOT read and would silently leave the app in development.
PEIARS_ENVIRONMENT=development

# --- API server --------------------------------------------------------------
PEIARS_API_HOST=127.0.0.1
PEIARS_API_PORT=8000
PEIARS_API_ROOT_PATH=/api/v1
# Comma-separated list of allowed browser origins (CORS). This is the ONE
# documented representation: JSON-array syntax is rejected with a clear
# validation error, and the wildcard "*" is prohibited (credentials are
# always enabled). Leave unset to use the built-in defaults; set empty to
# disable cross-origin access entirely.
PEIARS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (REQUIRED for the investigation workflow) ----------------------
# Full SQLAlchemy URL. Example for a local PostgreSQL instance:
#   postgresql+psycopg://peiars_app:YOUR_PASSWORD@localhost:5432/peiars_review
#
# MUST be set for authentication, review cases and the demonstration source.
PEIARS_DATABASE_URL=postgresql+psycopg://peiars_app:CHANGE_ME@localhost:5432/peiars_review

# When true, PostgreSQL is a required dependency and readiness probes it.
# Keep true for local development; the app fails at startup if the URL is
# missing while this is true (fail-closed, truthful readiness).
PEIARS_DATABASE_REQUIRED=true

# --- Authentication / session (REQUIRED) --------------------------------------
# Signs CSRF tokens (HMAC-SHA256). Generate a unique random value — do NOT
# keep the placeholder below: template placeholders are rejected at
# startup even when they are long enough to pass the length check.
#
# Cryptographically secure generation (.NET CSPRNG, instance-based API.
# RandomNumberGenerator.Create() + the instance GetBytes(byte[]) method
# exist on every .NET version from .NET Framework 2.0 through modern
# .NET, so this exact form works in both Windows PowerShell 5.1 and
# PowerShell 7+; the STATIC GetBytes overloads are .NET Core / .NET 5+
# only and are absent on .NET Framework. See Stage 4 of the Windows
# startup guide for the documented post-generation check):
#   $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
#   $bytes = New-Object byte[] 32
#   $rng.GetBytes($bytes)
#   -join ($bytes | ForEach-Object { $_.ToString('x2') })
#   POSIX:  openssl rand -hex 32
#
# Minimum 32 characters. When unset, auth endpoints fail closed with 503.
PEIARS_SESSION_SECRET=CHANGE_ME

# Absolute session lifetime (minutes).
PEIARS_SESSION_TTL_MINUTES=480
# Idle-timeout window (minutes).
PEIARS_SESSION_IDLE_TIMEOUT_MINUTES=240

# Cookie Secure flag. Local HTTP development MUST set false (the browser
# will not replay Secure cookies over http://localhost).
PEIARS_SESSION_COOKIE_SECURE=false

# Cookie names (defaults; change only for __Host- prefixed production).
PEIARS_SESSION_COOKIE_NAME=peiars_session
PEIARS_CSRF_COOKIE_NAME=peiars_csrf

# Failed-login lockout policy.
PEIARS_AUTH_LOCKOUT_THRESHOLD=5
PEIARS_AUTH_LOCKOUT_MINUTES=15

# --- Synthetic demonstration sources (PR-05B) ---------------------------------
# When true, the synthetic demonstration source adapter is registered and
# its records are retrievable. These records are EXPLICITLY FICTIONAL —
# they are NOT research findings, NOT ML anomaly scores, and NOT real
# public officials. Set true for local investigation-workflow testing.
# MUST be false in production.
PEIARS_DEMONSTRATION_SOURCES=true

# --- Connection pool (optional; defaults shown) --------------------------------
PEIARS_DB_POOL_SIZE=5
PEIARS_DB_MAX_OVERFLOW=10
PEIARS_DB_POOL_PRE_PING=true
PEIARS_DB_POOL_RECYCLE_SECONDS=1800
