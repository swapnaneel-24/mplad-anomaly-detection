{
  "components": {
    "schemas": {
      "CsrfTokenResponse": {
        "description": "Bootstrap CSRF token for the future React client.\n\nThe same value is set in the readable CSRF cookie; the client must\necho it in the ``X-CSRF-Token`` header on every state-changing\nrequest. A CSRF token is not a credential.",
        "properties": {
          "csrf_token": {
            "description": "Signed double-submit CSRF token.",
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfTokenResponse",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Machine-readable error payload (sanitized; no tracebacks).",
        "properties": {
          "code": {
            "description": "Stable machine-readable error code.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "additionalProperties": true,
            "title": "Details",
            "type": "object"
          },
          "message": {
            "description": "Human-readable, sanitized error message.",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "description": "Request ID for cross-referencing server logs.",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Envelope shared by every error response.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HealthLiveResponse": {
        "description": "Liveness: the API process can answer requests.",
        "properties": {
          "service": {
            "description": "Application name.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "alive",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Backend application version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthLiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Login credentials (bounded; login payloads cannot be oversized).",
        "properties": {
          "password": {
            "description": "Account password (8-128 characters).",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "description": "Login identifier (normalized server-side).",
            "maxLength": 64,
            "minLength": 3,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutResponse": {
        "description": "Logout acknowledgement (the session is revoked server-side).",
        "properties": {
          "status": {
            "description": "Fixed value: 'logged_out'.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "LogoutResponse",
        "type": "object"
      },
      "MetaResponse": {
        "description": "Non-sensitive application metadata (``GET /api/v1/meta``).",
        "properties": {
          "api_version": {
            "const": "v1",
            "description": "Versioned API namespace.",
            "title": "Api Version",
            "type": "string"
          },
          "app_version": {
            "description": "Backend application version.",
            "title": "App Version",
            "type": "string"
          },
          "application": {
            "description": "Application name.",
            "title": "Application",
            "type": "string"
          },
          "environment": {
            "enum": [
              "development",
              "test",
              "production"
            ],
            "title": "Environment",
            "type": "string"
          },
          "features": {
            "additionalProperties": {
              "enum": [
                "implemented",
                "planned"
              ],
              "type": "string"
            },
            "description": "Implemented versus planned application features.",
            "title": "Features",
            "type": "object"
          },
          "git_commit_sha": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Git commit SHA if supplied by the deployment environment; never fabricated.",
            "title": "Git Commit Sha"
          },
          "subsystems": {
            "additionalProperties": {
              "enum": [
                "available",
                "empty",
                "not_integrated"
              ],
              "type": "string"
            },
            "description": "Availability of major application subsystems.",
            "title": "Subsystems",
            "type": "object"
          }
        },
        "required": [
          "application",
          "api_version",
          "app_version",
          "environment",
          "features",
          "subsystems"
        ],
        "title": "MetaResponse",
        "type": "object"
      },
      "ReadinessCheck": {
        "description": "One configured dependency check (name and status only; no details).",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ready",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status"
        ],
        "title": "ReadinessCheck",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness: all configured required dependencies are ready.",
        "properties": {
          "checks": {
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            },
            "title": "Checks",
            "type": "array"
          },
          "status": {
            "const": "ready",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "Role": {
        "description": "Server-side application roles.",
        "enum": [
          "viewer",
          "reviewer",
          "admin"
        ],
        "title": "Role",
        "type": "string"
      },
      "SourceListResponse": {
        "description": "All registered sources (currently none are configured).",
        "properties": {
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceSummary"
            },
            "title": "Sources",
            "type": "array"
          }
        },
        "required": [
          "sources",
          "count"
        ],
        "title": "SourceListResponse",
        "type": "object"
      },
      "SourceSummary": {
        "description": "Public description of an approved, registered data source.",
        "properties": {
          "analysis_status": {
            "enum": [
              "verified_benchmark",
              "exploratory",
              "restricted",
              "blocked",
              "unavailable"
            ],
            "title": "Analysis Status",
            "type": "string"
          },
          "dataset_kind": {
            "enum": [
              "ulb_benchmark",
              "pmgsy_infrastructure",
              "mplads_administration"
            ],
            "title": "Dataset Kind",
            "type": "string"
          },
          "integrity_status": {
            "enum": [
              "verified",
              "unverified_legacy",
              "integrity_failed",
              "unavailable"
            ],
            "title": "Integrity Status",
            "type": "string"
          },
          "source_id": {
            "description": "Opaque registered source identifier (not a filesystem path).",
            "title": "Source Id",
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "dataset_kind",
          "integrity_status",
          "analysis_status"
        ],
        "title": "SourceSummary",
        "type": "object"
      },
      "UserResponse": {
        "description": "Sanitized public representation of an authenticated user.\n\nCarries only approved public fields: user id, username, display\nname, role and the effective permission list. Never a password\nhash, session token or account internals.",
        "properties": {
          "display_name": {
            "description": "Human-readable display name.",
            "title": "Display Name",
            "type": "string"
          },
          "id": {
            "description": "Stable user identifier (canonical actor reference).",
            "title": "Id",
            "type": "string"
          },
          "permissions": {
            "description": "Effective permissions derived from the role (server-side).",
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "$ref": "#/components/schemas/Role",
            "description": "Server-side role."
          },
          "username": {
            "description": "Normalized login identifier.",
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "permissions"
        ],
        "title": "UserResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyCookie": {
        "description": "Opaque session token issued by POST /api/v1/auth/login.",
        "in": "cookie",
        "name": "peiars_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Public Expenditure & Infrastructure Anomaly Review System (PEIARS) — versioned JSON API. Research evidence is served read-only and manifest-verified; an anomaly flag never implies fraud. This API never fits models, recomputes thresholds or mutates frozen research artifacts.",
    "title": "PEIARS API",
    "version": "0.4.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "description": "Issues a signed double-submit CSRF token: the value is set in the readable CSRF cookie and returned in the body. The client must echo it in the X-CSRF-Token header on every state-changing request (login, logout, and future writes).",
        "operationId": "csrf_api_v1_auth_csrf_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication is not configured."
          }
        },
        "summary": "CSRF token bootstrap",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Verifies credentials, creates a fresh server-side session and sets the secure session cookie. Failures are generic; throttled attempts return 429. Requires the X-CSRF-Token header from GET /api/v1/auth/csrf.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication required or invalid credentials."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error (invalid input)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many failed login attempts (throttled)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication is not configured or the database is unavailable."
          }
        },
        "summary": "Log in",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Requires a valid session and the X-CSRF-Token header. Revokes the server-side session (irreversible) and expires the cookies. Replay of the old session fails.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication required or invalid credentials."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error (invalid input)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many failed login attempts (throttled)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication is not configured or the database is unavailable."
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Log out",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Returns the authenticated user's approved public fields and effective permissions. Requires the session cookie.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication required or invalid credentials."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error (invalid input)."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many failed login attempts (throttled)."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Authentication is not configured or the database is unavailable."
          }
        },
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "summary": "Current user",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Proves the API process is answering requests. Performs no database, model, DVC or network access.",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Reports whether all configured, required application dependencies are ready. PR-02 configures no required external dependencies, so the default response is ready with an empty checks list. Optional research artifacts are not readiness dependencies.",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/meta": {
      "get": {
        "description": "Non-sensitive build and capability metadata. The Git commit SHA is included only when supplied by the deployment environment.",
        "operationId": "meta_api_v1_meta_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Application metadata",
        "tags": [
          "metadata"
        ]
      }
    },
    "/api/v1/sources": {
      "get": {
        "description": "Lists the approved, registered data sources. No sources are admitted in PR-02, so this returns an empty list. Sources are never discovered by scanning the filesystem.",
        "operationId": "list_sources_api_v1_sources_get",
        "parameters": [
          {
            "description": "Optional dataset-kind filter.",
            "in": "query",
            "name": "dataset_kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ulb_benchmark",
                    "pmgsy_infrastructure",
                    "mplads_administration"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional dataset-kind filter.",
              "title": "Dataset Kind"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceListResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Validation error (invalid dataset_kind filter)."
          }
        },
        "summary": "List approved sources",
        "tags": [
          "sources"
        ]
      }
    },
    "/api/v1/sources/{source_id}": {
      "get": {
        "description": "Fetches a single approved source by its opaque registered identifier. Path-like identifiers are rejected.",
        "operationId": "get_source_api_v1_sources__source_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "source_id",
            "required": true,
            "schema": {
              "title": "Source Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceSummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Source not registered."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid source identifier."
          }
        },
        "summary": "Get one approved source",
        "tags": [
          "sources"
        ]
      }
    }
  }
}
